COGNITIVE_APP_NAME="Cognitive OS API"
COGNITIVE_ENVIRONMENT=local
# URL-encode special characters in the database password.
COGNITIVE_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@localhost:5432/cognitive"
COGNITIVE_REGISTRATION_ENABLED=true
COGNITIVE_TOKEN_TTL_SECONDS=3600
COGNITIVE_EVIDENCE_DIRECTORY=.data/evidence
COGNITIVE_MAX_EVIDENCE_BYTES=10485760
