COGNITIVE_APP_NAME="Cognitive OS API"
COGNITIVE_ENVIRONMENT=local
# URL-encode special characters in the database password.
COGNITIVE_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@localhost:5432/cognitive"
COGNITIVE_REGISTRATION_ENABLED=true
COGNITIVE_TOKEN_TTL_SECONDS=3600
COGNITIVE_EVIDENCE_DIRECTORY=.data/evidence
COGNITIVE_MAX_EVIDENCE_BYTES=10485760

# Required for live observation, analysis, transcription and semantic search.
# Put the replacement key in .env, never in this example or in Git.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Vector columns use 1536 dimensions. Changing dimensions requires a migration and reindex.
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure: set the real connection string only in .env. Keep the container private.
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=cognitive-recordings
COGNITIVE_RECORDING_MAX_BYTES=262144000
COGNITIVE_RECORDING_MAX_SECONDS=600
COGNITIVE_RECORDING_FRAME_INTERVAL_SECONDS=10
COGNITIVE_RECORDING_LEASE_SECONDS=900
COGNITIVE_WORKER_LEASE_SECONDS=300
COGNITIVE_AGENT_MAX_TURNS_PER_SESSION=120
COGNITIVE_AGENT_MIN_INTERVAL_SECONDS=3
# Explicit browser origins for cross-origin HTTP and the live WebSocket.
COGNITIVE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
